{
  "name": "computation-system",
  "version": "0.4.0",
  "description": "Simulate computational models, such as Turing machines.",
  "keywords": [],
  "main": "dist/computation-system.umd.js",
  "module": "dist/computation-system.esm.js",
  "typings": "dist/types/computation-system.d.ts",
  "files": [
    "dist"
  ],
  "author": "'Snowman-s' <snowman.snowsnow@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Snowman-s/computation-system.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "prebuild": "rimraf dist",
    "build": "tsc --module commonjs --moduleResolution node10 && rollup -c rollup.config.ts && typedoc --out docs --entryPoints src/computation-system.ts --theme default",
    "start": "rollup -c rollup.config.ts -w",
    "test": "jest --coverage",
    "test:watch": "jest --coverage --watch",
    "test:prod": "npm run lint && npm run test -- --no-cache",
    "commit": "git add -A && git-cz"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "collectCoverageFrom": [
      "src/*.{js,ts}"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "colors": "^1.4.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-config": "^30.4.2",
    "lint-staged": "^17.3.0",
    "lodash.camelcase": "^4.3.0",
    "prettier": "^3.9.6",
    "prompt": "^1.3.0",
    "replace-in-file": "^9.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "semantic-release": "^25.0.9",
    "shelljs": "^0.10.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}

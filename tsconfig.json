{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "es2020",
    "module": "es2015",
    "lib": ["es2022", "dom"],
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declarationDir": "dist/types",
    "outDir": "dist/lib"
  },
  "include": ["src"]
}
